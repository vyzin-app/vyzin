# Backend API (NestJS)
VITE_API_URL=http://localhost:3000

# Firebase Web SDK (Authentication only — data goes through the backend)
# Copie de: Firebase Console → Configurações do projeto → Geral → vyzin-web → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=vyzin-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vyzin-app
VITE_FIREBASE_STORAGE_BUCKET=vyzin-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
