# HTTP port (default 3000 if omitted).
PORT=3000

# Origin allowed by CORS (frontend dev server). Default: http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3001

# ─── Desenvolvimento local (Firebase Emulators — recomendado) ───────────────
# Terminal 1: npm run emulators
# Terminal 2: npm run start:dev:local   (ou exporte estas vars e use start:dev)
# Terminal 3: npm run seed:local        (com emulators rodando)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GCLOUD_PROJECT=vyzin-app
FIREBASE_WEB_API_KEY=fake-api-key

# ─── Producao (Firestore/Auth reais) ───────────────────────────────────────
# Comente ou remova as vars de emulador acima e configure:
# FIREBASE_WEB_API_KEY=<Web API Key do Firebase Console>
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# ou FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# ou firebase-key.json na pasta backend/
